# ─────────────────────────────────────────────────────────────
#  Variabili d'ambiente — A.C.R.S.D. Khaybullova
#  Copia in `.env` (sviluppo) e imposta le stesse su Vercel (produzione).
# ─────────────────────────────────────────────────────────────

# DATABASE
#  • Sviluppo locale → file SQLite (nessun token):
#      DATABASE_URL="file:./dev.db"
#  • Produzione (Vercel) → Turso / libSQL:
#      DATABASE_URL="libsql://NOME-DB-ORG.turso.io"
#      DATABASE_AUTH_TOKEN="il-token-generato-da-turso"
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# AUTH — segreto per firmare le sessioni (JWT).
#  In produzione usa un valore lungo e casuale, es. generato con:
#      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambia-questo-valore-in-produzione"
